# ─────────────────────────────────────────────────────────────────────────────
# HOST nginx (the reverse proxy already on your server). TLS terminates HERE.
# One server block per client → proxies the single client domain to that client's
# web container port (WEB_HTTP_PORT). The web container serves the SPA and proxies
# /api to the backend internally, so you do NOT split /api here.
#
# Copy per client, set server_name + certs + the WEB_HTTP_PORT, reload nginx.
# ─────────────────────────────────────────────────────────────────────────────

server {
  listen 443 ssl;
  http2 on;
  server_name acme.example.com;

  ssl_certificate     /etc/letsencrypt/live/acme.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/acme.example.com/privkey.pem;

  # generous body size for document uploads/imports
  client_max_body_size 25m;

  location / {
    proxy_pass http://127.0.0.1:8081;      # WEB_HTTP_PORT for this client
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }
}

# HTTP → HTTPS
server {
  listen 80;
  server_name acme.example.com;
  return 301 https://$host$request_uri;
}
