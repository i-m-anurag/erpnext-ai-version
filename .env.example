# ─────────────────────────────────────────────────────────────────────────────
# Per-client deployment env. Copy to .env.<client> (e.g. .env.acme) and fill in.
# deploy/deploy.sh <client> copies the matching file to .env before running compose.
# NEVER commit a real .env.<client> — only this example is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── identity / container naming (multi-client isolation) ─────────────────────
CLIENT_SLUG=acme
COMPOSE_PROJECT_NAME=erp-acme          # scopes network + volumes
CONTAINER_PREFIX=erp-acme              # container name prefix: erp-acme-api, -web, ...
WEB_HTTP_PORT=8081                     # UNIQUE per client; host nginx proxies to this

# ── image selection (built + tagged locally by deploy/build.sh; no registry) ──
IMAGE_BACKEND=erp-backend
IMAGE_FRONTEND=erp-frontend
IMAGE_TAG=latest                       # or a git short SHA

# ── app ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
APP_NAME=ERP
APP_LOG_LEVEL=info
APP_PUBLIC_URL=https://acme.example.com   # the client's public URL (behind host nginx TLS)

# ── database (containerized — host is the compose service name) ───────────────
DB_HOST=postgres
DB_PORT=5432
DB_USER=erp
DB_PASSWORD=change-me-strong
DB_NAME=erp_acme
DB_SSL=false                           # false: in-cluster traffic on the private network

# ── redis (containerized) ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── auth (MUST be strong, >=16 chars; unique per client) ──────────────────────
AUTH_ACCESS_TOKEN_SECRET=change-me-access-secret-min-16
AUTH_REFRESH_TOKEN_SECRET=change-me-refresh-secret-min-16
AUTH_COOKIE_DOMAIN=acme.example.com
AUTH_COOKIE_SECURE=true                 # true behind host TLS

# ── email ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=no-reply@acme.example.com

# ── seeded admin (created on first provision) ─────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@acme.example.com
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=change-me-admin-password

# ── branding (optional) ───────────────────────────────────────────────────────
BRANDING_PRODUCT_NAME=IQ-SMART ERP
BRANDING_LOGO_URL=/branding/logo.svg

# ── provisioning ──────────────────────────────────────────────────────────────
MIGRATE_ON_START=true                   # run migrate+seed+sync:schema on container start

# ── module enablement (routers only mount for enabled modules) ────────────────
# Without these the API returns 404 on /api/auth etc. Enable what the client uses.
MODULE_AUTH=true
MODULE_PERMISSION=true
MODULE_CONFIG=true
MODULE_FORM=true
MODULE_MASTER=true
MODULE_COMMUNICATION=true
MODULE_ORG=true
MODULE_WORKFLOW=true
MODULE_LEDGER=true
MODULE_INVENTORY=false
