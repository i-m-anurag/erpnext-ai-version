{
  "slug": "item-tax-template",
  "version": 1,
  "title": "Item Tax Template",
  "layout": "two-column",
  "fields": [
    { "key": "title", "type": "text", "label": "Title", "required": true, "inList": true, "placeholder": "e.g. GST 18%", "validators": { "maxLength": 140 } },
    { "key": "company", "type": "master-lookup", "label": "Company", "inList": true, "optionsSource": { "master": "company" } },
    { "key": "disabled", "type": "checkbox", "label": "Disabled" },
    {
      "key": "taxes",
      "type": "table",
      "label": "Tax Rates",
      "required": true,
      "minRows": 1,
      "maxRows": 20,
      "columns": [
        { "key": "taxAccount", "type": "master-lookup", "label": "Tax Account", "required": true, "optionsSource": { "master": "account" } },
        { "key": "taxRate", "type": "number", "label": "Tax Rate (%)", "validators": { "min": 0, "max": 100 } },
        { "key": "notApplicable", "type": "checkbox", "label": "Not Applicable" }
      ]
    }
  ]
}
