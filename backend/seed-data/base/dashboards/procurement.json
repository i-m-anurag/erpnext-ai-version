{
  "slug": "procurement",
  "widgets": [
    { "type": "stat", "title": "Requisitions", "span": 1, "icon": "ph-note-pencil", "tone": "accent", "source": { "kind": "count", "master": "requisition" } },
    {
      "type": "stat", "title": "Purchase orders", "span": 1, "icon": "ph-receipt", "tone": "info",
      "source": { "kind": "count", "master": "purchase-order", "dateField": "poDate" }
    },
    { "type": "stat", "title": "Receipts", "span": 1, "icon": "ph-package", "tone": "success", "source": { "kind": "count", "master": "purchase-receipt" } },
    { "type": "stat", "title": "Invoices", "span": 1, "icon": "ph-file-text", "tone": "warning", "source": { "kind": "count", "master": "purchase-invoice" } },
    {
      "type": "chart", "title": "Purchase orders by vendor", "span": 2, "chart": "bar",
      "source": { "kind": "groupCount", "master": "purchase-order", "groupBy": "vendor", "dateField": "poDate" }
    },
    {
      "type": "chart", "title": "Requests by purpose", "span": 2, "chart": "pie",
      "source": { "kind": "groupCount", "master": "requisition", "groupBy": "materialRequestType" }
    },
    {
      "type": "table", "title": "Recent purchase orders", "span": 4,
      "source": { "kind": "recent", "master": "purchase-order", "limit": 8, "columns": ["vendor", "poDate"] }
    }
  ]
}
