{
  "slug": "purchase-order",
  "appliesTo": "purchase-order",
  "startState": "Draft",
  "editableStates": ["Draft"],
  "states": [
    { "name": "Draft", "color": "#6b7280", "allow": ["Submit"] },
    { "name": "Pending Approval", "color": "#f59e0b", "allow": ["Approve", "Reject"], "formReadOnly": true },
    { "name": "Approved", "color": "#22c55e", "allow": [], "formReadOnly": true },
    { "name": "Rejected", "color": "#ef4444", "allow": ["Reopen"], "formReadOnly": true }
  ],
  "rules": [
    {
      "name": "Submit",
      "trigger": { "on": "action", "action": "Submit", "fromState": "Draft", "roles": ["admin"] },
      "branches": [
        {
          "conditions": [{ "field": "vendor", "op": "==", "value": "Acme Supplies" }],
          "actions": [
            { "type": "set_state", "to": "Pending Approval" },
            { "type": "assign", "role": "admin", "strategy": "least_loaded" }
          ]
        },
        {
          "conditions": [],
          "actions": [{ "type": "set_state", "to": "Pending Approval" }]
        }
      ]
    },
    {
      "name": "Approve",
      "trigger": { "on": "action", "action": "Approve", "fromState": "Pending Approval", "roles": ["admin"], "requiresAssignee": true },
      "branches": [
        {
          "conditions": [],
          "actions": [
            { "type": "set_state", "to": "Approved" },
            { "type": "email", "template": "record-approved", "to": ["role:admin"] }
          ]
        }
      ]
    },
    {
      "name": "Reject",
      "trigger": { "on": "action", "action": "Reject", "fromState": "Pending Approval", "roles": ["admin"], "allowSelfApproval": false },
      "branches": [{ "conditions": [], "actions": [{ "type": "set_state", "to": "Rejected" }] }]
    },
    {
      "name": "Reopen",
      "trigger": { "on": "action", "action": "Reopen", "fromState": "Rejected", "roles": ["admin"] },
      "branches": [{ "conditions": [], "actions": [{ "type": "set_state", "to": "Draft" }] }]
    }
  ]
}
