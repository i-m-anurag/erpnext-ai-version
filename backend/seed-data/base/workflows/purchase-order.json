{
  "slug": "purchase-order",
  "appliesTo": "purchase-order",
  "startState": "Draft",
  "states": [
    { "name": "Draft", "color": "#6b7280" },
    { "name": "Pending Approval", "color": "#f59e0b" },
    { "name": "Approved", "color": "#22c55e", "allowCreateNext": true },
    { "name": "Rejected", "color": "#ef4444" }
  ],
  "rules": [
    {
      "name": "Submit",
      "trigger": { "on": "action", "action": "Submit", "fromState": "Draft", "roles": ["admin"] },
      "branches": [
        {
          "conditions": [],
          "actions": [
            { "type": "set_state", "to": "Pending Approval" },
            { "type": "assign", "role": "admin", "byLimit": { "amountField": "amount", "branchField": "branch" } }
          ]
        }
      ]
    },
    {
      "name": "Approve",
      "trigger": { "on": "action", "action": "Approve", "fromState": "Pending Approval", "roles": ["admin"], "requiresAssignee": true },
      "branches": [
        {
          "conditions": [],
          "actions": [
            { "type": "set_state", "to": "Approved" },
            { "type": "email", "template": "record-approved", "to": ["role:admin"] }
          ]
        }
      ]
    },
    {
      "name": "Reject",
      "trigger": { "on": "action", "action": "Reject", "fromState": "Pending Approval", "roles": ["admin"] },
      "branches": [{ "conditions": [], "actions": [{ "type": "set_state", "to": "Rejected" }] }]
    },
    {
      "name": "Reopen",
      "trigger": { "on": "action", "action": "Reopen", "fromState": "Rejected", "roles": ["admin"] },
      "branches": [{ "conditions": [], "actions": [{ "type": "set_state", "to": "Draft" }] }]
    }
  ]
}
