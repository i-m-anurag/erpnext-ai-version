{
  "slug": "purchase-order",
  "appliesTo": "purchase-order",
  "startState": "Draft",
  "states": [
    { "name": "Draft", "color": "#6b7280" },
    { "name": "Pending Approval", "color": "#f59e0b" },
    { "name": "Approved", "color": "#22c55e", "allowCreateNext": true },
    { "name": "Rejected", "color": "#ef4444" }
  ],
  "attributes": [
    { "key": "approvalLimit", "type": "number", "source": "matrix", "matrix": { "role": "admin", "branchField": "branch" } }
  ],
  "approvals": [
    {
      "action": "Submit",
      "pendingState": "Pending Approval",
      "onApproved": "Approved",
      "onRejected": "Rejected",
      "rules": [
        {
          "when": { "<=": [ { "var": "doc.amount" }, { "var": "lookup.approvalLimit" } ] },
          "steps": [ { "approver": "role", "role": "manager", "branchScoped": true } ]
        },
        {
          "when": { ">": [ { "var": "doc.amount" }, { "var": "lookup.approvalLimit" } ] },
          "steps": [
            { "approver": "role", "role": "manager", "branchScoped": true },
            { "approver": "role", "role": "director", "branchScoped": true }
          ]
        }
      ]
    }
  ],
  "rules": [
    {
      "name": "Submit",
      "trigger": { "on": "action", "action": "Submit", "fromState": "Draft", "roles": ["admin"] },
      "branches": [{ "conditions": [], "actions": [] }]
    },
    {
      "name": "Reopen",
      "trigger": { "on": "action", "action": "Reopen", "fromState": "Rejected", "roles": ["admin"] },
      "branches": [{ "conditions": [], "actions": [{ "type": "set_state", "to": "Draft" }] }]
    }
  ]
}
