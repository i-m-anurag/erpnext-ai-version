{
  "slug": "otp-verification",
  "subject": "Your IQ Smart ERP verification code",
  "variables": ["BrandName", "Purpose", "OTPCode", "OTPValidity", "UserEmail", "RequestTime", "AdminEmail"],
  "html": "<!DOCTYPE html>\n<html lang=\"en\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<meta name=\"supported-color-schemes\" content=\"light dark\">\n<title>Your IQ Smart ERP verification code</title>\n<!--[if mso]><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml><![endif]-->\n<style>\n  @media only screen and (max-width:620px){\n    .w600{width:100% !important;}\n    .px{padding-left:26px !important;padding-right:26px !important;}\n    .h1{font-size:27px !important;line-height:33px !important;}\n    .otp{font-size:36px !important;letter-spacing:10px !important;}\n    .lbl{width:130px !important;}\n  }\n</style>\n</head>\n<body style=\"margin:0;padding:0;background-color:#faf9f7;\">\n<span style=\"display:none!important;visibility:hidden;opacity:0;color:transparent;height:0;width:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;\">Your one-time code is inside — it expires in {{OTPValidity}} minutes.</span>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"background-color:#faf9f7;\">\n<tr><td align=\"center\" style=\"padding:40px 12px;\">\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"600\" class=\"w600\" style=\"width:600px;max-width:600px;\">\n<!-- ============================================================\n     BRANDING — replace the <img> below with your own logo.\n     Use a hosted https:// URL (not a local file). Recommended:\n     PNG/SVG on a transparent background, max 320x72px, WHITE or\n     light artwork (it sits on the indigo band). Update alt and\n     width/height to match your file. To use a plain wordmark\n     instead, delete the <img> line and un-comment the fallback.\n     Band colour = --erp-accent #5f79eb.\n     ============================================================ -->\n<tr><td style=\"background-color:#5f79eb;border-radius:6px 6px 0 0;\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%;\">\n    <tr>\n      <td align=\"left\" valign=\"middle\" class=\"px\" style=\"padding:22px 36px;\">\n        <img src=\"https://YOUR-DOMAIN.com/logo.png\" alt=\"{{BrandName}}\" width=\"112\" height=\"30\" style=\"display:block;border:0;outline:none;text-decoration:none;height:30px;width:auto;max-width:220px;font-family:Arial,Helvetica,sans-serif;font-size:17px;letter-spacing:3px;color:#ffffff;font-weight:bold;\">\n        <!-- Text wordmark fallback (use instead of the img):\n        <span style=\"font-family:Arial,Helvetica,sans-serif;font-size:17px;line-height:30px;mso-line-height-rule:exactly;letter-spacing:4px;color:#ffffff;font-weight:bold;text-transform:uppercase;\">{{BrandName}}</span>\n        -->\n      </td>\n      <td align=\"right\" valign=\"middle\" class=\"px\" style=\"padding:22px 36px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:30px;mso-line-height-rule:exactly;letter-spacing:2px;color:#d7ddfb;text-transform:uppercase;\">IQ Smart ERP</td>\n    </tr>\n  </table>\n</td></tr><tr><td style=\"background-color:#ffffff;border-left:1px solid #eaeaea;border-right:1px solid #eaeaea;\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%;\"><tr><td class=\"px\" style=\"padding:40px 44px 0 44px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:14px;mso-line-height-rule:exactly;letter-spacing:2.2px;text-transform:uppercase;color:#5f79eb;font-weight:bold;\">One-time password</td></tr><tr><td class=\"px h1\" style=\"padding:14px 44px 0 44px;font-family:Arial,Helvetica,sans-serif;font-size:32px;line-height:40px;mso-line-height-rule:exactly;color:#1a1c1b;font-weight:bold;letter-spacing:-0.4px;\">Your verification code</td></tr><tr><td class=\"px\" style=\"padding:20px 44px 0 44px;font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:26px;mso-line-height-rule:exactly;color:#46464d;\">Use the code below to complete {{Purpose}} in IQ Smart ERP. Never share it &mdash; our team will not ask you for it.</td></tr><tr><td class=\"px\" style=\"padding:30px 44px 0 44px;\">\n     <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%;background-color:#eef1fe;border:1px solid #dbe1fd;border-radius:6px;\">\n       <tr><td align=\"center\" class=\"otp\" style=\"padding:32px 12px 8px 12px;font-family:'Courier New',Courier,monospace;font-size:44px;line-height:50px;mso-line-height-rule:exactly;letter-spacing:16px;color:#4a63d8;font-weight:bold;\">{{OTPCode}}</td></tr>\n       <tr><td align=\"center\" style=\"padding:0 12px 26px 12px;font-family:Arial,Helvetica,sans-serif;font-size:11px;line-height:16px;mso-line-height-rule:exactly;letter-spacing:2px;text-transform:uppercase;color:#46464d;\">Expires in {{OTPValidity}} minutes</td></tr>\n     </table>\n   </td></tr><tr><td class=\"px\" style=\"padding:28px 44px 0 44px;\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%;background-color:#f4f3f1;border-radius:6px;\">\n  <tr>\n    <td class=\"lbl\" width=\"170\" valign=\"top\" style=\"width:170px;padding:18px 14px 12px 20px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;letter-spacing:1.2px;text-transform:uppercase;color:#46464d;\">Account</td>\n    <td valign=\"top\" style=\"padding:18px 20px 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:20px;mso-line-height-rule:exactly;color:#1a1c1b;font-weight:bold;\">{{UserEmail}}</td>\n  </tr><tr>\n    <td class=\"lbl\" width=\"170\" valign=\"top\" style=\"width:170px;padding:0 14px 12px 20px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;letter-spacing:1.2px;text-transform:uppercase;color:#46464d;\">Requested at</td>\n    <td valign=\"top\" style=\"padding:0 20px 12px 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:20px;mso-line-height-rule:exactly;color:#1a1c1b;font-weight:bold;\">{{RequestTime}} IST</td>\n  </tr><tr>\n    <td class=\"lbl\" width=\"170\" valign=\"top\" style=\"width:170px;padding:0 14px 18px 20px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;letter-spacing:1.2px;text-transform:uppercase;color:#46464d;\">Action</td>\n    <td valign=\"top\" style=\"padding:0 20px 18px 0;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:20px;mso-line-height-rule:exactly;color:#1a1c1b;font-weight:bold;\">{{Purpose}}</td>\n  </tr>\n  </table>\n</td></tr><tr><td class=\"px\" style=\"padding:28px 44px 0 44px;\"><table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%;\"><tr><td height=\"1\" style=\"height:1px;line-height:1px;font-size:0;background-color:#eaeaea;\">&nbsp;</td></tr></table></td></tr><tr><td class=\"px\" style=\"padding:18px 44px 0 44px;font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:21px;mso-line-height-rule:exactly;color:#46464d;\">If you did not request this code, someone may know your password. Change it immediately and inform <a href=\"mailto:{{AdminEmail}}\" style=\"color:#4a63d8;text-decoration:underline;\">{{AdminEmail}}</a>.</td></tr><tr><td style=\"height:36px;line-height:36px;font-size:0;\">&nbsp;</td></tr></table></td></tr>\n<tr><td style=\"height:1px;line-height:1px;font-size:0;background-color:#eaeaea;border-radius:0 0 6px 6px;\">&nbsp;</td></tr>\n<tr><td style=\"padding:26px 10px 0 10px;\">\n  <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"width:100%;\">\n    <tr><td class=\"px\" style=\"padding:0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;color:#46464d;\">\n      Sent automatically by <span style=\"color:#1a1c1b;font-weight:bold;\">IQ Smart ERP</span> &mdash; please do not reply to this address.\n    </td></tr>\n    <tr><td class=\"px\" style=\"padding:14px 8px 0 8px;font-family:Arial,Helvetica,sans-serif;font-size:12px;line-height:20px;mso-line-height-rule:exactly;color:#46464d;\">\n      {{BrandName}} &middot; [Street address], [City], [State] [PIN], India<br>\n      <a href=\"https://example.com/support\" style=\"color:#4a63d8;text-decoration:underline;\">Support</a> &nbsp;&middot;&nbsp;\n      <a href=\"https://example.com/preferences\" style=\"color:#4a63d8;text-decoration:underline;\">Notification preferences</a> &nbsp;&middot;&nbsp;\n      <a href=\"https://example.com/unsubscribe\" style=\"color:#4a63d8;text-decoration:underline;\">Unsubscribe</a>\n    </td></tr>\n  </table>\n</td></tr><tr><td style=\"height:28px;line-height:28px;font-size:0;\">&nbsp;</td></tr></table></td></tr></table></body></html>",
  "text": "Your verification code: {{OTPCode}}\n\nUse this code to complete {{Purpose}} in IQ Smart ERP. It expires in {{OTPValidity}} minutes. Never share it — our team will not ask you for it.\n\nAccount: {{UserEmail}}\nRequested at: {{RequestTime}} IST\nAction: {{Purpose}}\n\nIf you did not request this code, someone may know your password. Change it immediately and inform {{AdminEmail}}.\n\nSent automatically by IQ Smart ERP — please do not reply."
}
