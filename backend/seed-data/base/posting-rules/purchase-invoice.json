{
  "voucherType": "purchase-invoice",
  "amountField": "grandTotal",
  "partyField": "supplier",
  "cases": [
    {
      "when": { "field": "purchaseReceipt", "isSet": true },
      "lines": [
        { "account": "stock-received-not-billed", "side": "debit" },
        { "account": "creditors", "side": "credit", "withParty": true }
      ]
    },
    {
      "when": { "field": "purchaseReceipt", "isSet": false },
      "lines": [
        { "account": "purchase-expenses", "side": "debit" },
        { "account": "creditors", "side": "credit", "withParty": true }
      ]
    }
  ]
}
